# --- Go ---

# Тесты и профилирование.
*.test
*.out
*.prof
coverage.*
cover.html

# Артефакты сборки.
/bin/
/dist/
*.exe
*.so
*.dylib

# go.work здесь не коммитится: он локальный инструмент разработчика,
# связывающий несколько независимых репозиториев на его машине.
# В CI библиотека собирается сама по себе, без workspace.
go.work
go.work.sum

# --- секреты ---

.env
.env.*
!.env.example
*.pem
*.key

# --- редакторы и ОС ---

.idea/
.vscode/
*.swp
.DS_Store

# --- инструменты ---

.claude/settings.local.json
